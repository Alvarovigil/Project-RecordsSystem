# Supabase — crea el proyecto en https://supabase.com y copia estos valores
# desde Project Settings → API. Duplica este fichero como .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para tareas de servidor (importar discos al catálogo). NUNCA se expone
# al navegador: no lleva el prefijo NEXT_PUBLIC_ a propósito.
SUPABASE_SERVICE_ROLE_KEY=

# Discogs (ya en uso para buscar y añadir discos)
DISCOGS_TOKEN=
