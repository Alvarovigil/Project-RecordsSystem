# Supabase — crea el proyecto en https://supabase.com y copia estos valores
# desde Project Settings → API. Duplica este fichero como .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para tareas de servidor (importar discos al catálogo). NUNCA se expone
# al navegador: no lleva el prefijo NEXT_PUBLIC_ a propósito.
SUPABASE_SERVICE_ROLE_KEY=

# Discogs (ya en uso para buscar y añadir discos)
DISCOGS_TOKEN=

# Panel de administración: contraseña única, mínimo 8 caracteres.
# Sin ella, /admin queda cerrado.
ADMIN_PASSWORD=

# Dominio público del sitio. En Vercel se deduce solo; ponlo cuando tengas
# dominio propio para que los enlaces compartidos apunten ahí.
NEXT_PUBLIC_SITE_URL=

# Perfil de maqueta: entra como el coleccionista de ejemplo sin pasar por el
# login. Solo funciona en desarrollo; en un build de producción se ignora.
NEXT_PUBLIC_FAKE_SESSION=0
