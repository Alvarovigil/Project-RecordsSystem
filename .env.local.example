# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Perfil de maqueta: entra como el coleccionista de ejemplo sin pasar por el
# login. Solo funciona en desarrollo; en un build de producción se ignora.
NEXT_PUBLIC_FAKE_SESSION=0

# --- producción ---------------------------------------------------------
# La URL pública real. Sin esto, los enlaces que se comparten y los metadatos
# de Open Graph apuntan a localhost.
NEXT_PUBLIC_SITE_URL=https://rackr.club
